# Keep the build context to sources only; target/ alone is hundreds of MB.
target/
.git/
.github/

# Live accounts, administrator secrets and SQLite sidecars never enter an image.
*.db
*.db-*
*.sqlite
*.sqlite-*
fx_state.json
.pi/
.env
.env.*
!/.env.example
*.log
tiingo_apikeys.txt

