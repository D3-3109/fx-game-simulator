# Keep shell scripts and container files LF even where Windows Git defaults to CRLF.
# A CRLF entrypoint.sh fails inside Linux containers with "$'\r': command not found".
* text=auto eol=lf

# Windows-only tooling keeps its native line endings.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
